<?xml version="1.0" encoding="utf-8"?>
<!-- No se copia nada a la nube ni a otros dispositivos: los emparejamientos dependen de claves
     del Keystore de este dispositivo y no hay datos de salud persistidos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
